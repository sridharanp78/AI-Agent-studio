PORT=3000
HOST=0.0.0.0
AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
SLACK_WEBHOOK_URL=
APP_ACCESS_USER=admin
APP_ACCESS_PASSWORD=change-this-to-a-long-random-password

# Optional MCP discovery. Use exact hostnames in MCP_ALLOWED_HOSTS.
MCP_SERVERS_JSON=[{"name":"Example MCP","url":"https://mcp.example.com/mcp","tokenEnv":"EXAMPLE_MCP_TOKEN","allowedTools":["read_status"]}]
MCP_ALLOWED_HOSTS=mcp.example.com
EXAMPLE_MCP_TOKEN=
